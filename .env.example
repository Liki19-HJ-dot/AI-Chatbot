# Settings for Open AI Chat (uses Google Gemini).
# NEVER put a real key in a file you push to GitHub. Put it on your own computer or in your host's settings.

# "live" calls Gemini. "mock" returns placeholder replies (no key needed) so you can test the UI.
AI_MODE=live

# Create a free key at https://aistudio.google.com/apikey (starts with "AIza")
GEMINI_API_KEY=AQ.Ab8RN6IjvmBdjBp4xwBgCl8lHR9CeY8-YqvQA3jxbdNcqTC5ow

# Models. See https://ai.google.dev/gemini-api/docs/models for the names available to your key.
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Only change this if you use a Gemini-compatible proxy.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

PORT=4000

# Optional: the origin allowed to call the API from a browser (leave empty when the
# frontend and API are served by this same server, which is the default).
APP_ORIGIN=

# Set to true ONLY while setting up: shows the real Gemini error in the chat instead of a friendly message.
DEBUG_ERRORS=false
